# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Database — leave DATABASE_URL empty to use local SQLite (zero-setup dev).
# For Postgres (recommended for prod / docker-compose):
# DATABASE_URL=postgres://uyim:uyim@localhost:5432/uyim
DATABASE_URL=

# Redis / Celery — CELERY_TASK_ALWAYS_EAGER=True runs tasks inline with no broker needed (dev default).
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# JWT
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# Currency
USD_UZS_RATE=12700

# SMS OTP — Eskiz.uz (https://eskiz.uz/). Leave blank to use console/debug OTP (code is returned
# in the API response when DEBUG=True, and printed to the server log) — safe for local development.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
OTP_DEBUG_STATIC_CODE=1234

# Telegram bot — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=uyim_bot
TELEGRAM_WEBHOOK_SECRET=change-me

# Payme — https://developer.help.paycom.uz/
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_KEY=

# Click — https://docs.click.uz/
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# CBU exchange-rate sync — https://cbu.uz/uz/arkhiv-kursov-valyut/json/
CBU_RATE_API=https://cbu.uz/uz/arkhiv-kursov-valyut/json/
