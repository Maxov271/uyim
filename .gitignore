# Node (mobile app phase 2)
node_modules/
.expo/

# Android TWA signing keys + build artifacts — local-only, never committed.
# The keystore protects the app's identity (Play Store updates must be signed with the
# same key forever); .apk/.aab binaries go to GitHub Releases instead of git history.
mobile/android-twa/keystore/
mobile/android-twa/builds/

# iOS signing material, if any ever lands here (Xcode manages this via the user's own
# Apple ID — nothing is generated by this repo's tooling today, but reserve the path).
mobile/ios-webview/keys/
*.p12
*.mobileprovision

# OS
.DS_Store

# Editors
.vscode/
.idea/
